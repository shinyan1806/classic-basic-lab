10 REM 数当てゲーム
100 RANDOMIZE
110 LET ANSWER = INT(RND * 10) + 1
120 PRINT "1から10までの数を当ててください。"
130 INPUT GUESS
140 IF GUESS = ANSWER THEN
150     PRINT "正解です！"
160     GOTO 230
170 ELSEIF GUESS < ANSWER THEN
180     PRINT "もっと大きいです。"
190 ELSE
200     PRINT "もっと小さいです。"
210 END IF
220 GOTO 130
230 END
